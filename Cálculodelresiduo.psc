Algoritmo Cálculodelresiduo
	Escribir "Programa para calcular el cociente entero y el residuo de la división."
	Definir numero1 Como Entero
	Definir numero2 Como Entero
	Definir cociente Como Entero
	Definir residuo Como Entero
	Escribir "Digite el primer número entero"
	Leer numero1
	Escribir "Digite el segundo número entero"
	Leer numero2
	cociente <- numero1 DIV numero2
    residuo <- numero1 MOD numero2
	Escribir "El cociente es"
	Mostrar cociente
	Escribir "El residuo es"
	Mostrar residuo 
FinAlgoritmo
