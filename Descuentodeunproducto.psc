Algoritmo Descuentodeunproducto
	Escribir "Programa para calcular el descuento de un producto"
    Escribir "Digite el precio del producto."
    Definir precio, descuento, porcentaje Como Real
    Leer precio
	Escribir "Digite el porcentaje de descuento"
    Leer porcentaje
    Escribir "El descuento es"
    descuento<- precio*porcentaje/100
	Mostrar descuento
	Escribir "El precio Final es"
	Mostrar precio-descuento
FinAlgoritmo
