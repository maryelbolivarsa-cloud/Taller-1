Algoritmo Intercambiodevalores
	Escribir "Programa para intercambiar valores."
	Definir numeroA Como Entero
	Definir numeroB Como Entero
	Definir auxiliar Como Entero
	Escribir "Digite el primer número entero"
	Leer numeroA
	Escribir "Digite el segundo número entero"
	Leer numeroB
	auxiliar <- numeroA
	numeroA <- numeroB
	numeroB <- auxiliar
	Escribir "Después del intercambio:"
    Escribir "El primer número es:"
    Mostrar numeroA
    Escribir "El segundo número es:"
    Mostrar numeroB
FinAlgoritmo
