Algoritmo Númerodentrodeunrango
	Escribir "Programa para saber si un número está dentro de un Rango"
	Escribir "Digite un número entero"
	Definir numero Como Entero
	Definir enRango Como Logico
	Leer numero
	enRango <- numero >= 10 Y numero <= 50
	Escribir "Se encuentra entre 10 y 50, incluyendo ambos valores?"
	Mostrar enRango
FinAlgoritmo
