Algoritmo ProgramaMultiplicación
	Escribir "Programa de Multiplicación de dos variables"
	Escribir "Primero digite un numero entero a multipliicar"
	Definir num1 Como Real
	Leer num1
	Escribir "Luego digite un numero entero a multiplicar el anterior"
	Definir num2 Como Real
	Leer num2
	Escribir "El resultado es"
	Mostrar num1*num2
	
FinAlgoritmo
